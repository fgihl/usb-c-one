(version 1)

(rule "Keep copper pour clear of USB_90 pairs"
  (constraint clearance (min 0.4mm))
  (condition "(A.Type == 'Zone' && B.NetClass == 'USB_90') || (B.Type == 'Zone' && A.NetClass == 'USB_90')"))

(rule "USB_90 intra-class clearance"
  (constraint clearance (min 0.15mm))
  (condition "A.NetClass == 'USB_90' && B.NetClass == 'USB_90'"))
